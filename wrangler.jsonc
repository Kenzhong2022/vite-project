{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vite-project", // 你的 Worker 名称
  "compatibility_date": "2026-10-28", // 建议使用当前日期
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application" // SPA 回退核心配置
  }
}